# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it's already in .gitignore.

# --- Supabase (Postgres + Auth + pgvector) ---
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser or the widget.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (embeddings + generation) ---
GEMINI_API_KEY=

# --- Groq (optional fast backup for generation) ---
GROQ_API_KEY=

# --- Midtrans (sandbox) ---
# Merchant Portal (sandbox) -> Settings -> Access Keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- Demo chatbot (Phase 7, no-login landing page widget) ---
# Run `npm run seed:demo` to create it, then paste the id it prints here.
NEXT_PUBLIC_DEMO_CHATBOT_ID=
